{
  "name": "tsakascuts",
  "version": "1.1.0",
  "productName": "TsakasCuts",
  "description": "Valorant montage editor",
  "author": "TsakasOptimizations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node export.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.tsakas.tsakascuts",
    "files": ["*.js", "index.html", "icon.ico"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": { "artifactName": "TsakasCuts-Setup-${version}.${ext}" },
    "publish": { "provider": "github", "owner": "TsakasOptimizations", "repo": "TsakasCuts", "releaseType": "release" }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  }
}
